# Copiar a .env (nunca commitear .env)
DEBUG=True
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=arqueocatalog
POSTGRES_USER=arqueocatalog
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Dirección pública que codifica el QR (vacío: usa el host de la petición)
URL_PUBLICA=

# Puerto publicado en el host
BACKEND_PORT=8000

# Ruta del instalador de la app (por defecto, media/app/arqueocatalog.apk)
#APK_PATH=
