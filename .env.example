# Copiar a .env (nunca commitear .env)
DEBUG=True
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Para probar con el celular por LAN, agregar la IP de la PC (ej. 192.168.1.14)
CORS_ALLOWED_ORIGINS=http://localhost:8081
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=arqueocatalog
POSTGRES_USER=arqueocatalog
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Puerto publicado en el host
BACKEND_PORT=8000

# --- Producción (Dokploy + Cloudflare Tunnel); ver docs/DESPLIEGUE.md ---
# DEBUG=False
# ALLOWED_HOSTS=arqueocatalog.lrpoma.site
# CORS_ALLOWED_ORIGINS=
# CSRF_TRUSTED_ORIGINS=https://arqueocatalog.lrpoma.site
# URL pública con https: la usan el QR y las URLs de las fotos
# PUBLIC_BASE_URL=https://arqueocatalog.lrpoma.site
# IP real del cliente (log de accesos y throttling) cuando todo el tráfico llega por el túnel
# IP_CLIENTE_HEADER=CF-Connecting-IP
